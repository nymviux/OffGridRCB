{
  "name": "offgrid",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "munim-bluetooth": "0.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-notify-kit": "^10.8.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tools",
    "fake-node": "tsx tools/fake-node/cli.ts",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:build:lowmem": "bash scripts/android-build-lowmem.sh",
    "android:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:release": "npm run android:prebuild && npm run android:build && npm run android:install"
  },
  "private": true,
  "allowScripts": {
    "esbuild": false
  }
}
